hostname "CHZ-2930F-24G-02"
module 1 type jl255a
trunk 21 trk1 lacp
trunk 19-20 trk3 lacp
timesync ntp
ntp unicast
ntp server 10.51.0.55 iburst
ntp enable
time daylight-time-rule western-europe
